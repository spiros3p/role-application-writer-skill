  "installTargets": {
    "globalAgents": "~/.agents/skills/",
    "projectAgents": ".agents/skills/",
    "claudeCodePlugin": ".claude-plugin/plugin.json",
    "claudeCodeSkills": ".claude/skills/"
  }
