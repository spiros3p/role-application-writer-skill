{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "job-application-writer",
  "version": "1.2.0",
  "description": "Agent skill bundle that writes a complete job application for one role: an ATS-compatible CV plus a tailored cover letter, produced by a fixed six-skill pipeline.",
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "claude-code",
    "job-search",
    "resume",
    "cover-letter",
    "ats"
  ],
  "author": {
    "name": "Spyridon Peppas"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spiros3p/job-application-writer.git"
  },
  "homepage": "https://github.com/spiros3p/job-application-writer#readme",
  "bugs": "https://github.com/spiros3p/job-application-writer/issues",
  "entrySkill": "job-application-writer",
  "skillsRoot": ".agents/skills",

  "runtime": {
    "workspaceRoot": "~/agent-workspace/job-research/",
    "requiredPaths": [
      "inputs/career-experiance/career-experiance.md",
      "inputs/roles/"
    ],
    "optionalPaths": [
      "inputs/cover-letters/",
      "inputs/projects-context/"
    ],
    "outputPath": "outputs/applications/<company>-<role-slug>/",
    "externalServices": [
      {
        "name": "CheckMyATS",
        "url": "https://checkmyats.com/resume-checker/",
        "required": false,
        "note": "Optional ATS scoring. The skill degrades gracefully and reports unavailability instead of blocking delivery."
      }
    ]
  },

  "pipeline": [
    "job-application-writer",
    "job-description-analyzer",
    "resume-tailor",
    "resume-bullet-writer",
    "resume-ats-optimizer",
    "cover-letter-generator",
    "resume-formatter",
    "humanizer"
  ],

  "skills": [
    {
      "name": "job-application-writer",
      "path": ".agents/skills/job-application-writer",
      "version": "1.2.0",
      "role": "orchestrator",
      "license": "MIT",
      "origin": "original",
      "author": "Spyridon Peppas, Hermes Agent",
      "dependsOn": [
        "job-description-analyzer",
        "resume-tailor",
        "resume-bullet-writer",
        "resume-ats-optimizer",
        "cover-letter-generator",
        "resume-formatter",
        "humanizer"
      ]
    },
    {
      "name": "job-description-analyzer",
      "path": ".agents/skills/job-description-analyzer",
      "version": null,
      "role": "pipeline:step-a",
      "license": "MIT",
      "origin": "upstream",
      "upstream": {
        "repo": "https://github.com/Paramchoudhary/ResumeSkills",
        "ref": "74ae19e7c62b0516d1c298328e5544976c12da5d",
        "path": "skills/job-description-analyzer/SKILL.md",
        "copyright": "Copyright (c) 2026 Resume Skills"
      },
      "localModifications": ["description re-folded to a YAML block scalar"]
    },
    {
